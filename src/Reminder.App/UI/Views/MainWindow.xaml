                                                                Style="{StaticResource IntervalPartInputStyle}"
                                                                Text="{Binding IntervalMinutesInput, UpdateSourceTrigger=PropertyChanged}" />
                                                            <TextBlock
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="分钟" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Margin="2,5,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Text="{Binding IntervalError}"
                                                            Visibility="{Binding HasIntervalError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsScheduledTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="108" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="6" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Margin="0,0,0,6"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="频率" />
                                                                <ComboBox
                                                                    Width="108"
                                                                    AutomationProperties.Name="指定时间频率"
                                                                    DisplayMemberPath="Label"
                                                                    ItemsSource="{Binding RecurrenceChoices}"
                                                                    SelectedItem="{Binding SelectedRecurrenceChoice, Mode=TwoWay}"
                                                                    Style="{StaticResource InputComboBoxStyle}" />
                                                            </StackPanel>

                                                            <Grid Grid.Column="2">
                                                                <StackPanel Visibility="{Binding ShowWeeklyFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        Margin="0,0,0,6"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource TextMutedBrush}"
                                                                        Text="星期" />
                                                                    <ComboBox
                                                                        Width="112"
                                                                        AutomationProperties.Name="每周提醒星期"
                                                                        DisplayMemberPath="Label"
                                                                        ItemsSource="{Binding WeekdayChoices}"
                                                                        SelectedItem="{Binding SelectedWeekdayChoice, Mode=TwoWay}"
                                                                        Style="{StaticResource InputComboBoxStyle}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock
                                                                    Margin="0,0,0,6"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="指定日期和时间" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel
                                                                        Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowYearField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="76"
                                                                            MaxLength="4"
                                                                            AutomationProperties.Name="提醒年份"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding YearInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="年" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowMonthField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="58"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒月份"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding MonthInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="月" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowDayField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="58"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒日期"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding DayInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="日" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowTimeFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="58"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒小时"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding HourInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="时" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="4"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowTimeFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="58"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒分钟"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding MinuteInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="分" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock
                                                            Margin="2,5,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Text="{Binding ScheduleError}"
                                                            Visibility="{Binding HasScheduleError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel
                                                    Grid.Column="4"
                                                    Visibility="{Binding ShowTermination, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="终止次数" />
                                                    <ComboBox
                                                        Width="120"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="终止次数"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding TerminationChoices}"
                                                        MaxDropDownHeight="260"
                                                        SelectedItem="{Binding SelectedTerminationChoice, Mode=TwoWay}"
                                                        Style="{StaticResource InputComboBoxStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="6">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="息屏和锁屏" />

                                                    <StackPanel Visibility="{Binding IsFixedInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox
                                                            Width="178"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="固定时间事件息屏和锁屏策略"
                                                            DisplayMemberPath="Label"
                                                            ItemsSource="{Binding FixedSystemPolicyChoices}"
                                                            SelectedItem="{Binding SelectedFixedSystemPolicy, Mode=TwoWay}"
                                                            Style="{StaticResource InputComboBoxStyle}" />
                                                        <ComboBox
                                                            Width="178"
                                                            Margin="0,6,0,0"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="固定时间事件息屏和锁屏期间是否提醒"
                                                            DisplayMemberPath="Label"
                                                            ItemsSource="{Binding SystemNotificationChoices}"
                                                            SelectedItem="{Binding SelectedFixedSystemNotification, Mode=TwoWay}"
                                                            Style="{StaticResource InputComboBoxStyle}"
                                                            Visibility="{Binding ShowFixedSystemNotificationChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <ComboBox
                                                        Width="178"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="指定时间事件息屏和锁屏期间是否提醒"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding SystemNotificationChoices}"
                                                        SelectedItem="{Binding SelectedScheduledSystemNotification, Mode=TwoWay}"
                                                        Style="{StaticResource InputComboBoxStyle}"
                                                        Visibility="{Binding IsScheduledTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="15"
                        Foreground="{StaticResource TextMutedBrush}"
                        IsHitTestVisible="False"
                        Text="没有找到匹配的事件"
                        Visibility="{Binding ShowNoSearchResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>

                <Grid
                    x:Name="SettingsPage"
                    AutomationProperties.AutomationId="SettingsPage"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="138" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Grid.Column="0"
                        Margin="0,12,0,18"
                        Padding="10"
                        VerticalAlignment="Top"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                        <StackPanel>
                            <TextBlock
                                Margin="10,6,10,9"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextMutedBrush}"
                                Text="设置导航" />
                            <Button
                                AutomationProperties.Name="定位到渲染模式设置"
                                Click="RenderingSettingsIndexButton_OnClick"
                                Content="渲染模式"
                                Style="{StaticResource SettingsIndexButtonStyle}" />
                            <Button
                                Margin="0,2,0,0"
                                AutomationProperties.Name="定位到通知设置"
                                Click="NotificationSettingsIndexButton_OnClick"
                                Content="通知"
                                Style="{StaticResource SettingsIndexButtonStyle}" />
                            <Button
                                Margin="0,2,0,0"
                                AutomationProperties.Name="定位到恢复默认设置"
                                Click="RestoreDefaultsSettingsIndexButton_OnClick"
                                Content="恢复默认设置"
                                Style="{StaticResource SettingsIndexButtonStyle}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer
                        x:Name="SettingsScrollViewer"
                        Grid.Column="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="SettingsContentPanel"
                            MaxWidth="800"
                            Margin="0,12,0,18"
                            HorizontalAlignment="Stretch">
                            <Border
                                x:Name="RenderingSettingsSection"
                                Padding="26"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="250" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,32,0">
                                        <TextBlock
                                            FontSize="19"
                                            FontWeight="SemiBold"
                                            Text="渲染模式" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="13"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="兼容模式使用 CPU 绘制界面；硬件优先模式由 WPF 根据显卡能力选择渲染路径。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ComboBox
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="渲染模式"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding RenderingModeChoices}"
                                        SelectedItem="{Binding SelectedRenderingModeChoice, Mode=TwoWay}"
                                        Style="{StaticResource InputComboBoxStyle}" />
                                </Grid>
                            </Border>

                            <Border
                                x:Name="NotificationSettingsSection"
                                Margin="0,14,0,0"
                                Padding="26"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="19"
                                        FontWeight="SemiBold"
                                        Text="通知" />

                                    <Grid Margin="0,22,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="330" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,32,0">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="统一通知延迟时间" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="设置通知延迟的时间。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <StackPanel
                                                x:Name="SnoozeDurationInputGroup"
                                                HorizontalAlignment="Left"
                                                Orientation="Horizontal"
                                                LostKeyboardFocus="SnoozeDurationInputGroup_OnLostKeyboardFocus">
                                                <StackPanel
                                                    Margin="0,0,7,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding ShowSnoozeDurationDays, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBox
                                                        Width="72"
                                                        MaxLength="3"
                                                        AutomationProperties.Name="通知延迟天数"
                                                        KeyDown="SnoozeDurationTextBox_OnKeyDown"
                                                        Style="{StaticResource IntervalPartInputStyle}"
                                                        Text="{Binding SnoozeDurationDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="天" />
                                                </StackPanel>
                                                <StackPanel
                                                    Margin="0,0,7,0"
                                                    Orientation="Horizontal"
                                                    Visibility="{Binding ShowSnoozeDurationHours, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBox
                                                        Width="68"
                                                        MaxLength="4"
                                                        AutomationProperties.Name="通知延迟小时"
                                                        KeyDown="SnoozeDurationTextBox_OnKeyDown"
                                                        Style="{StaticResource IntervalPartInputStyle}"
                                                        Text="{Binding SnoozeDurationHoursInput, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock
                                                        Margin="4,0,0,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="13"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="小时" />
                                                </StackPanel>
                                                <TextBox
                                                    Width="78"
                                                    MaxLength="6"
                                                    AutomationProperties.Name="通知延迟分钟"
                                                    KeyDown="SnoozeDurationTextBox_OnKeyDown"
                                                    Style="{StaticResource IntervalPartInputStyle}"
                                                    Text="{Binding SnoozeDurationMinutesInput, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="分钟" />
                                            </StackPanel>
                                            <TextBlock
                                                Margin="2,5,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource DangerBrush}"
                                                Text="{Binding SnoozeDurationError}"
                                                Visibility="{Binding HasSnoozeDurationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Height="1"
                                        Margin="0,22"
                                        Background="{StaticResource BorderBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="330" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,32,0">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="延迟时间超过事件间隔时" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="此选项只作用于提醒间隔小于上一选项设定时间的固定时间事件。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="延迟时间超过事件间隔时"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding SnoozeOverflowPolicyChoices}"
                                            SelectedItem="{Binding SelectedSnoozeOverflowPolicyChoice, Mode=TwoWay}"
                                            Style="{StaticResource InputComboBoxStyle}" />
                                    </Grid>

                                    <Border
                                        Height="1"
                                        Margin="0,22"
                                        Background="{StaticResource BorderBrush}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="330" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,32,0">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="通知横幅显示时长" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="横幅淡出后通知仍会进入通知中心。"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <ComboBox
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="通知横幅显示时长"
                                            DisplayMemberPath="Label"
                                            ItemsSource="{Binding NotificationDisplayDurationChoices}"
                                            SelectedItem="{Binding SelectedNotificationDisplayDurationChoice, Mode=TwoWay}"
                                            Style="{StaticResource InputComboBoxStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="RestoreDefaultsSettingsSection"
                                Margin="0,14,0,0"
                                Padding="26"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,32,0">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="SemiBold"
                                            Text="恢复默认设置" />
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            FontSize="12"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="恢复所有设置为默认，并且不会删除事件记录。"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="恢复默认设置"
                                        Click="RestoreDefaultSettingsButton_OnClick"
                                        Content="恢复默认设置"
                                        Style="{StaticResource DangerButtonStyle}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border
            Grid.Row="2"
            Height="30"
            Padding="28,0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                x:Name="NotificationStatusPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                ToolTipService.InitialShowDelay="500">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                <Setter Property="ToolTipService.IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel.ToolTip>
                    <ToolTip
                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                        Placement="Top">
                        <TextBlock
                            MaxWidth="380"
                            Text="{Binding NotificationStatusHelp}"
                            TextWrapping="Wrap" />
                    </ToolTip>
                </StackPanel.ToolTip>
                <TextBlock
                    Margin="0,0,6,0"
                    FontSize="11"
                    Text="●">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    FontSize="11"
                    Text="{Binding NotificationStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
