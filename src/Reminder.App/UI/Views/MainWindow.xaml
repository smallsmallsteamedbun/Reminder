<Window
    x:Class="Reminder.App.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:Reminder.App.UI.ViewModels"
    Title="Reminder"
    Width="1180"
    Height="760"
    MinWidth="760"
    MinHeight="560"
    AutomationProperties.AutomationId="ReminderMainWindow"
    Background="{StaticResource PageBackgroundBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    Foreground="{StaticResource TextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,21"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="40"
                        Height="40"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="R" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="{Binding AppName}" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource PrimarySubtleBrush}"
                                CornerRadius="11">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="{Binding VersionText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="轻量、安静地照顾你的工作节奏" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="26"
                        FontWeight="SemiBold"
                        Text="提醒事件" />
                    <TextBlock
                        Margin="0,5,0,0"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding EventSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button
                        x:Name="GlobalPauseToggleButton"
                        AutomationProperties.AutomationId="GlobalPauseToggleButton"
                        Click="GlobalActionButton_OnClick"
                        Command="{Binding ToggleGlobalPauseCommand}"
                        Content="{Binding GlobalPauseToggleText}"
                        Style="{StaticResource ReminderButtonStyle}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="1000"
                        ToolTipService.ShowDuration="10000">
                        <Button.ToolTip>
                            <ToolTip
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                Placement="Top">
                                <TextBlock Text="{Binding GlobalPauseToggleHint}" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button
                        x:Name="RestartAllButton"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="RestartAllButton"
                        Click="GlobalActionButton_OnClick"
                        Command="{Binding RestartAllCommand}"
                        Content="全部重启"
                        Style="{StaticResource ReminderButtonStyle}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="1000"
                        ToolTipService.ShowDuration="10000">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="重启所有已开启事件的倒计时" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button
                        Margin="12,0,0,0"
                        AutomationProperties.AutomationId="AddEventButton"
                        Command="{Binding AddEventCommand}"
                        Content="＋ 添加事件"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Margin="0,16,0,0"
                Padding="14,10"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="{Binding IsGlobalPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="全部暂停已开启" />
                    <TextBlock
                        Margin="18,0,8,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="暂停" />
                    <ComboBox
                        Width="150"
                        AutomationProperties.Name="全部暂停时长"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding GlobalPauseChoices}"
                        SelectedItem="{Binding SelectedGlobalPauseChoice, Mode=TwoWay}"
                        Style="{StaticResource InputComboBoxStyle}" />
                    <TextBlock
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding GlobalPauseRemainingText}"
                        Visibility="{Binding ShowGlobalPauseCountdown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Border>

            <ScrollViewer
                x:Name="EventListScrollViewer"
                Grid.Row="2"
                Margin="0,14,0,0"
                HorizontalScrollBarVisibility="Disabled"
                PreviewMouseWheel="EventListScrollViewer_OnPreviewMouseWheel"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="EventItemsControl"
                    ItemsSource="{Binding Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:EventViewModel}">
                            <Border
                                Opacity="{Binding CardOpacity}"
                                Style="{StaticResource EventCardStyle}">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    PanningMode="HorizontalOnly"
                                    VerticalScrollBarVisibility="Disabled">
                                    <Grid MinWidth="1072">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="14,14,14,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="410" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBox
                                                    MaxLength="50"
                                                    AutomationProperties.Name="事件名称"
                                                    DataObject.Pasting="EventNameTextBox_OnPasting"
                                                    KeyDown="EditableTextBox_OnKeyDown"
                                                    LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                    PreviewTextInput="EventNameTextBox_OnPreviewTextInput"
                                                    Tag="Name"
                                                    Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Margin="2,5,0,0" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="Text" Value="{Binding StatusText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="运行中">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    <Setter Property="Text" Value="{Binding NameError}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding PauseCommand}"
                                                Content="{Binding PauseButtonText}"
                                                IsEnabled="{Binding CanPauseOrResume}"
                                                Style="{StaticResource ReminderButtonStyle}"
                                                Visibility="{Binding ShowPauseButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding RestartCommand}"
                                                Content="重启"
                                                IsEnabled="{Binding CanRestart}"
                                                Style="{StaticResource ReminderButtonStyle}"
                                                Visibility="{Binding ShowRestartButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <StackPanel
                                                Grid.Column="{Binding CountdownColumn}"
                                                Grid.ColumnSpan="{Binding CountdownColumnSpan}"
                                                Margin="4,1,12,0">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding CountdownLabel}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding CountdownText}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="4"
                                                Margin="6,0,8,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top">
                                                <CheckBox
                                                    AutomationProperties.Name="事件开关"
                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                    Style="{StaticResource ToggleSwitchStyle}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="已关闭" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="已开启" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button
                                                Grid.Column="5"
                                                VerticalAlignment="Top"
                                                Command="{Binding DeleteCommand}"
                                                Content="删除"
                                                Style="{StaticResource DangerFilledButtonStyle}" />
                                        </Grid>

                                        <Border
                                            Grid.Row="1"
                                            Padding="14,12"
                                            Background="{StaticResource SurfaceSubtleBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,1,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="196" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="536" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="108" />
                                                    <ColumnDefinition Width="14" />
                                                    <ColumnDefinition Width="182" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0">
                                                    <TextBlock
                                                        Margin="0,0,0,7"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="事件类型" />
                                                    <Border
                                                        Background="{StaticResource SurfaceBrush}"
                                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="9">
                                                        <UniformGrid Columns="2">
                                                            <RadioButton
                                                                AutomationProperties.Name="固定时间事件"
                                                                Content="固定时间事件"
                                                                GroupName="{Binding Id}"
                                                                IsChecked="{Binding IsFixedInterval, Mode=TwoWay}"
                                                                Style="{StaticResource SegmentedChoiceStyle}" />
                                                            <RadioButton
                                                                AutomationProperties.Name="指定时间事件"
                                                                Content="指定时间事件"
                                                                GroupName="{Binding Id}"
                                                                IsChecked="{Binding IsScheduledTime, Mode=TwoWay}"
                                                                Style="{StaticResource SegmentedChoiceStyle}" />
                                                        </UniformGrid>
                                                    </Border>
                                                    <TextBlock
                                                        Margin="0,9,0,0"
                                                        FontSize="12"
                                                        Foreground="{StaticResource TextSecondaryBrush}"
                                                        Text="{Binding ScheduleSummary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <Grid Grid.Column="2">
                                                    <StackPanel Visibility="{Binding IsFixedInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock
                                                            Margin="0,0,0,6"
                                                            FontSize="11"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            Text="提醒时间间隔" />
                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            LostKeyboardFocus="IntervalInputGroup_OnLostKeyboardFocus">
                                                            <StackPanel
                                                                Margin="0,0,10,0"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding ShowIntervalDays, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox
                                                                    Width="64"
                                                                    MaxLength="3"
                                                                    AutomationProperties.Name="提醒间隔天数"
                                                                    KeyDown="IntervalTextBox_OnKeyDown"
                                                                    Text="{Binding IntervalDaysInput, UpdateSourceTrigger=PropertyChanged}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasIntervalError}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Text="天" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Margin="0,0,10,0"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding ShowIntervalHours, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox
                                                                    Width="72"
                                                                    MaxLength="4"
                                                                    AutomationProperties.Name="提醒间隔小时"
                                                                    KeyDown="IntervalTextBox_OnKeyDown"
                                                                    Text="{Binding IntervalHoursInput, UpdateSourceTrigger=PropertyChanged}">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding HasIntervalError}" Value="True">
                                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock
                                                                    Margin="7,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Text="小时" />
                                                            </StackPanel>
                                                            <TextBox
                                                                Width="82"
                                                                MaxLength="6"
                                                                AutomationProperties.Name="提醒间隔分钟"
                                                                KeyDown="IntervalTextBox_OnKeyDown"
                                                                Text="{Binding IntervalMinutesInput, UpdateSourceTrigger=PropertyChanged}">
                                                                <TextBox.Style>
                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding HasIntervalError}" Value="True">
                                                                                <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBox.Style>
                                                            </TextBox>
                                                            <TextBlock
                                                                Margin="7,0,0,0"
                                                                VerticalAlignment="Center"
                                                                FontSize="13"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                Text="分钟" />
                                                        </StackPanel>
                                                        <TextBlock
                                                            Margin="2,5,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Text="{Binding IntervalError}"
                                                            Visibility="{Binding HasIntervalError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <StackPanel Visibility="{Binding IsScheduledTime, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="82" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="92" />
                                                                <ColumnDefinition Width="8" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <TextBlock
                                                                    Margin="0,0,0,6"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="频率" />
                                                                <ComboBox
                                                                    Width="82"
                                                                    AutomationProperties.Name="指定时间频率"
                                                                    DisplayMemberPath="Label"
                                                                    ItemsSource="{Binding RecurrenceChoices}"
                                                                    SelectedItem="{Binding SelectedRecurrenceChoice, Mode=TwoWay}"
                                                                    Style="{StaticResource InputComboBoxStyle}" />
                                                            </StackPanel>

                                                            <Grid Grid.Column="2">
                                                                <StackPanel Visibility="{Binding ShowWeeklyFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock
                                                                        Margin="0,0,0,6"
                                                                        FontSize="11"
                                                                        Foreground="{StaticResource TextMutedBrush}"
                                                                        Text="星期" />
                                                                    <ComboBox
                                                                        Width="92"
                                                                        AutomationProperties.Name="每周提醒星期"
                                                                        DisplayMemberPath="Label"
                                                                        ItemsSource="{Binding WeekdayChoices}"
                                                                        SelectedItem="{Binding SelectedWeekdayChoice, Mode=TwoWay}"
                                                                        Style="{StaticResource InputComboBoxStyle}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <StackPanel Grid.Column="4">
                                                                <TextBlock
                                                                    Margin="0,0,0,6"
                                                                    FontSize="11"
                                                                    Foreground="{StaticResource TextMutedBrush}"
                                                                    Text="指定日期和时间" />
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="82" />
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="66" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel
                                                                        Grid.Column="0"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowYearField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="64"
                                                                            MaxLength="4"
                                                                            AutomationProperties.Name="提醒年份"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding YearInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="年" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="1"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowMonthField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="48"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒月份"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding MonthInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="月" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="2"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowDayField, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="48"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒日期"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding DayInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="日" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="3"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowTimeFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="48"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒小时"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding HourInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="时" />
                                                                    </StackPanel>
                                                                    <StackPanel
                                                                        Grid.Column="4"
                                                                        Orientation="Horizontal"
                                                                        Visibility="{Binding ShowTimeFields, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBox
                                                                            Width="48"
                                                                            MaxLength="2"
                                                                            AutomationProperties.Name="提醒分钟"
                                                                            KeyDown="EditableTextBox_OnKeyDown"
                                                                            LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                                            Tag="SchedulePart"
                                                                            Text="{Binding MinuteInput, UpdateSourceTrigger=PropertyChanged}"
                                                                            Style="{StaticResource SchedulePartInputStyle}" />
                                                                        <TextBlock
                                                                            Margin="3,0,0,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="13"
                                                                            Text="分" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock
                                                            Margin="2,5,0,0"
                                                            FontSize="12"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            Text="{Binding ScheduleError}"
                                                            Visibility="{Binding HasScheduleError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>

                                                <StackPanel
                                                    Grid.Column="4"
                                                    Visibility="{Binding ShowTermination, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="终止次数" />
                                                    <ComboBox
                                                        Width="104"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="终止次数"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding TerminationChoices}"
                                                        MaxDropDownHeight="260"
                                                        SelectedItem="{Binding SelectedTerminationChoice, Mode=TwoWay}"
                                                        Style="{StaticResource InputComboBoxStyle}" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="6">
                                                    <TextBlock
                                                        Margin="0,0,0,6"
                                                        FontSize="11"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        Text="息屏和锁屏" />

                                                    <StackPanel Visibility="{Binding IsFixedInterval, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <ComboBox
                                                            Width="178"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="固定时间事件息屏和锁屏策略"
                                                            DisplayMemberPath="Label"
                                                            ItemsSource="{Binding FixedSystemPolicyChoices}"
                                                            SelectedItem="{Binding SelectedFixedSystemPolicy, Mode=TwoWay}"
                                                            Style="{StaticResource InputComboBoxStyle}" />
                                                        <ComboBox
                                                            Width="178"
                                                            Margin="0,6,0,0"
                                                            HorizontalAlignment="Left"
                                                            AutomationProperties.Name="固定时间事件息屏和锁屏期间是否提醒"
                                                            DisplayMemberPath="Label"
                                                            ItemsSource="{Binding SystemNotificationChoices}"
                                                            SelectedItem="{Binding SelectedFixedSystemNotification, Mode=TwoWay}"
                                                            Style="{StaticResource InputComboBoxStyle}"
                                                            Visibility="{Binding ShowFixedSystemNotificationChoice, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>

                                                    <ComboBox
                                                        Width="178"
                                                        HorizontalAlignment="Left"
                                                        AutomationProperties.Name="指定时间事件息屏和锁屏期间是否提醒"
                                                        DisplayMemberPath="Label"
                                                        ItemsSource="{Binding SystemNotificationChoices}"
                                                        SelectedItem="{Binding SelectedScheduledSystemNotification, Mode=TwoWay}"
                                                        Style="{StaticResource InputComboBoxStyle}"
                                                        Visibility="{Binding IsScheduledTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </ScrollViewer>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border
            Grid.Row="2"
            Height="30"
            Padding="28,0"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">
            <StackPanel
                x:Name="NotificationStatusPanel"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                ToolTipService.InitialShowDelay="500">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="ToolTipService.IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                <Setter Property="ToolTipService.IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <StackPanel.ToolTip>
                    <ToolTip
                        DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                        Placement="Top">
                        <TextBlock
                            MaxWidth="380"
                            Text="{Binding NotificationStatusHelp}"
                            TextWrapping="Wrap" />
                    </ToolTip>
                </StackPanel.ToolTip>
                <TextBlock
                    Margin="0,0,6,0"
                    FontSize="11"
                    Text="●">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock
                    FontSize="11"
                    Text="{Binding NotificationStatus}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NotificationsAvailable}" Value="False">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>
