<Window
    x:Class="Reminder.App.UI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Reminder.App.UI.Controls"
    xmlns:viewModels="clr-namespace:Reminder.App.UI.ViewModels"
    Title="Reminder"
    Width="1180"
    Height="760"
    MinWidth="760"
    MinHeight="560"
    AutomationProperties.AutomationId="ReminderMainWindow"
    Background="{StaticResource PageBackgroundBrush}"
    FontFamily="{StaticResource AppFontFamily}"
    Foreground="{StaticResource TextPrimaryBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="HomeSlotContentStyle" TargetType="ContentControl">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <Trigger Property="Content" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SearchClearButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SearchHistoryRowButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style
            x:Key="SearchHistoryClearButtonStyle"
            TargetType="Button"
            BasedOn="{StaticResource SearchHistoryRowButtonStyle}">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="SettingsIndexButtonStyle" TargetType="Button">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="IndexBackground"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="7">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IndexBackground" Property="Background" Value="{StaticResource SurfaceSubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IndexBackground" Property="Background" Value="{StaticResource PrimarySubtleBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DataTemplate x:Key="HomeEventCardTemplate">
            <Button
                Width="300"
                Height="82"
                Padding="16,11"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.Name="{Binding Name}"
                Click="HomeEventCard_OnClick"
                MouseEnter="HomeEventCard_OnMouseEnter"
                MouseLeave="HomeEventCard_OnMouseLeave"
                Style="{StaticResource HomeEventCardButtonStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="15"
                            FontWeight="SemiBold"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="{Binding CountdownText}" />
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{StaticResource PageBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="28,21"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border
                        Width="40"
                        Height="40"
                        Background="{StaticResource PrimaryBrush}"
                        CornerRadius="10">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="R" />
                    </Border>
                    <StackPanel
                        Width="160"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="19"
                                FontWeight="SemiBold"
                                Text="{Binding AppName}" />
                            <Border
                                Margin="6,0,0,0"
                                Padding="5,4"
                                VerticalAlignment="Center"
                                Background="{StaticResource PrimarySubtleBrush}"
                                CornerRadius="11">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource PrimaryBrush}"
                                    Text="{Binding VersionText}" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="轻量、安静地照顾你的工作节奏"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="5"
                    VerticalAlignment="Center"
                    Background="{StaticResource SurfaceSubtleBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <Button
                            x:Name="HomeNavigationButton"
                            AutomationProperties.AutomationId="HomeNavigationButton"
                            Click="HomeNavigationButton_OnClick"
                            Content="主页"
                            Style="{StaticResource NavigationButtonStyle}" />
                        <Button
                            x:Name="EventsNavigationButton"
                            Margin="2,0"
                            AutomationProperties.AutomationId="EventsNavigationButton"
                            Click="EventsNavigationButton_OnClick"
                            Content="事件"
                            Style="{StaticResource NavigationButtonStyle}" />
                        <Button
                            x:Name="SettingsNavigationButton"
                            AutomationProperties.AutomationId="SettingsNavigationButton"
                            Click="SettingsNavigationButton_OnClick"
                            Content="设置"
                            Style="{StaticResource NavigationButtonStyle}" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,18,28,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="SharedActionBar" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid
                    x:Name="EventSummaryPanel"
                    Grid.Column="0"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="210" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="{Binding EventSummary}" />
                    <Grid Grid.Column="2">
                        <TextBox
                            x:Name="EventSearchTextBox"
                            Height="40"
                            Padding="9,5,34,5"
                            AutomationProperties.Name="搜索事件"
                            GotKeyboardFocus="EventSearchTextBox_OnGotKeyboardFocus"
                            KeyDown="EventSearchTextBox_OnKeyDown"
                            MaxLength="100"
                            Style="{StaticResource InputTextBoxStyle}"
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="25,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextMutedBrush}"
                            IsHitTestVisible="False"
                            Text="搜索事件">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button
                            Margin="0,0,4,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="清空搜索"
                            Click="ClearEventSearchButton_OnClick"
                            Content="×"
                            Style="{StaticResource SearchClearButtonStyle}"
                            Visibility="{Binding HasSearchText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Popup
                            x:Name="EventSearchHistoryPopup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=EventSearchTextBox}"
                            PopupAnimation="Fade"
                            StaysOpen="True">
                            <Border
                                Width="280"
                                Margin="0,5,0,0"
                                Padding="8"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                                <StackPanel>
                                    <TextBlock
                                        Margin="8,4,8,6"
                                        FontSize="11"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        Text="最近搜索" />
                                    <ItemsControl ItemsSource="{Binding SearchHistory}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="30" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        AutomationProperties.Name="搜索历史记录"
                                                        Click="SearchHistoryItem_OnClick"
                                                        Content="{Binding}"
                                                        Style="{StaticResource SearchHistoryRowButtonStyle}"
                                                        Tag="{Binding}" />
                                                    <Button
                                                        Grid.Column="1"
                                                        AutomationProperties.Name="删除搜索记录"
                                                        Click="DeleteSearchHistoryButton_OnClick"
                                                        Content="×"
                                                        Style="{StaticResource SearchClearButtonStyle}"
                                                        Tag="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border
                                        Height="1"
                                        Margin="8,6,8,2"
                                        Background="{StaticResource BorderBrush}" />
                                    <Button
                                        AutomationProperties.Name="清空搜索记录"
                                        Click="ClearSearchHistoryButton_OnClick"
                                        Content="清空搜索记录"
                                        Style="{StaticResource SearchHistoryClearButtonStyle}" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Grid>

                <StackPanel
                    x:Name="GlobalActionsPanel"
                    Grid.Column="1"
                    Orientation="Horizontal">
                    <Border
                        Margin="0,0,10,0"
                        Padding="10,0"
                        VerticalAlignment="Stretch"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="{Binding IsGlobalPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="全部暂停" />
                            <ComboBox
                                Width="142"
                                Margin="0,4"
                                AutomationProperties.Name="全部暂停时长"
                                DisplayMemberPath="Label"
                                ItemsSource="{Binding GlobalPauseChoices}"
                                SelectedItem="{Binding SelectedGlobalPauseChoice, Mode=TwoWay}"
                                Style="{StaticResource InputComboBoxStyle}" />
                            <TextBlock
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="{Binding GlobalPauseRemainingText}"
                                Visibility="{Binding ShowGlobalPauseCountdown, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                    <Button
                        x:Name="GlobalPauseToggleButton"
                        AutomationProperties.AutomationId="GlobalPauseToggleButton"
                        Click="GlobalActionButton_OnClick"
                        Command="{Binding ToggleGlobalPauseCommand}"
                        Content="{Binding GlobalPauseToggleText}"
                        Style="{StaticResource ReminderButtonStyle}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="1000"
                        ToolTipService.ShowDuration="10000">
                        <Button.ToolTip>
                            <ToolTip
                                DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                Placement="Top">
                                <TextBlock Text="{Binding GlobalPauseToggleHint}" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button
                        x:Name="RestartAllButton"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="RestartAllButton"
                        Click="GlobalActionButton_OnClick"
                        Command="{Binding RestartAllCommand}"
                        Content="全部重启"
                        Style="{StaticResource ReminderButtonStyle}"
                        ToolTipService.BetweenShowDelay="0"
                        ToolTipService.InitialShowDelay="1000"
                        ToolTipService.ShowDuration="10000">
                        <Button.ToolTip>
                            <ToolTip Placement="Top">
                                <TextBlock Text="重启所有已开启固定时间事件，并恢复全部事件" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button
                        x:Name="AddEventButton"
                        Margin="12,0,0,0"
                        AutomationProperties.AutomationId="AddEventButton"
                        Command="{Binding AddEventCommand}"
                        Content="＋ 添加事件"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="PageHost" Grid.Row="1" Margin="0,14,0,0">
                <Grid
                    x:Name="HomePage"
                    AutomationProperties.AutomationId="HomePage">
                    <Viewbox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        StretchDirection="DownOnly">
                    <Grid
                        Width="800"
                        Height="430">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="430" />
                            <ColumnDefinition Width="350" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="HomeTimerButton"
                            Width="390"
                            Height="390"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Click="HomeTimerButton_OnClick"
                            Style="{StaticResource CircleButtonStyle}">
                            <Grid>
                                <controls:CountdownRingsControl
                                    x:Name="HomeCountdownRings"
                                    RemainingSeconds="{Binding SelectedHomeEvent.RemainingSeconds}" />
                                <StackPanel
                                    Width="230"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="{Binding SelectedHomeEvent.StatusText}"
                                        TextAlignment="Center" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="28"
                                        FontWeight="SemiBold"
                                        Text="{Binding SelectedHomeEvent.CountdownText}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="17"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource PrimaryBrush}"
                                        Text="{Binding SelectedHomeEvent.Name}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="17"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="暂无正在计时的事件"
                                    Visibility="{Binding HasHomeEvents, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                            </Grid>
                        </Button>

                        <Grid
                            Grid.Column="1"
                            Height="320"
                            Margin="12,0,0,0"
                            ClipToBounds="False"
                            VerticalAlignment="Center">
                            <ContentControl
                                x:Name="HomeTopCard"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Content="{Binding HomeTopEvent}"
                                ContentTemplate="{StaticResource HomeEventCardTemplate}"
                                Style="{StaticResource HomeSlotContentStyle}" />
                            <ContentControl
                                x:Name="HomeMiddleCard"
                                Margin="34,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{Binding HomeMiddleEvent}"
                                ContentTemplate="{StaticResource HomeEventCardTemplate}"
                                Style="{StaticResource HomeSlotContentStyle}" />
                            <ContentControl
                                x:Name="HomeBottomCard"
                                Margin="0,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Content="{Binding HomeBottomEvent}"
                                ContentTemplate="{StaticResource HomeEventCardTemplate}"
                                Style="{StaticResource HomeSlotContentStyle}" />
                        </Grid>
                    </Grid>
                    </Viewbox>
                </Grid>

                <Grid
                    x:Name="EventPage"
                    AutomationProperties.AutomationId="EventPage"
                    Visibility="Collapsed">

            <ScrollViewer
                x:Name="EventListScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                PreviewMouseWheel="EventListScrollViewer_OnPreviewMouseWheel"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl
                    x:Name="EventItemsControl"
                    ItemsSource="{Binding FilteredEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type viewModels:EventViewModel}">
                            <Border
                                Opacity="{Binding CardOpacity}"
                                Style="{StaticResource EventCardStyle}">
                                <ScrollViewer
                                    HorizontalScrollBarVisibility="Auto"
                                    PanningMode="HorizontalOnly"
                                    VerticalScrollBarVisibility="Disabled">
                                    <Grid MinWidth="1072">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="14,14,14,12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="410" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="78" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="96" />
                                                <ColumnDefinition Width="74" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBox
                                                    MaxLength="50"
                                                    AutomationProperties.Name="事件名称"
                                                    DataObject.Pasting="EventNameTextBox_OnPasting"
                                                    KeyDown="EditableTextBox_OnKeyDown"
                                                    LostKeyboardFocus="EditableTextBox_OnLostKeyboardFocus"
                                                    PreviewTextInput="EventNameTextBox_OnPreviewTextInput"
                                                    Tag="Name"
                                                    Text="{Binding NameInput, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox" BasedOn="{StaticResource InputTextBoxStyle}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                                <TextBlock Margin="2,5,0,0" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                            <Setter Property="Text" Value="{Binding StatusText}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StatusText}" Value="运行中">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding HasNameError}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                    <Setter Property="Text" Value="{Binding NameError}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button
                                                Grid.Column="1"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding PauseCommand}"
                                                Content="{Binding PauseButtonText}"
                                                IsEnabled="{Binding CanPauseOrResume}"
                                                Style="{StaticResource ReminderButtonStyle}"
                                                Visibility="{Binding ShowPauseButton, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                            <Button
                                                Grid.Column="2"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Top"
                                                Command="{Binding RestartCommand}"
                                                Content="重启"
                                                IsEnabled="{Binding CanRestart}"
                                                Style="{StaticResource ReminderButtonStyle}"
                                                Visibility="{Binding ShowRestartButton, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                            <StackPanel
                                                Grid.Column="{Binding CountdownColumn}"
                                                Grid.ColumnSpan="{Binding CountdownColumnSpan}"
                                                Margin="4,1,12,0">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextMutedBrush}"
                                                    Text="{Binding CountdownLabel}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    FontSize="17"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding CountdownText}" />
                                            </StackPanel>

                                            <StackPanel
                                                Grid.Column="4"
                                                Margin="6,0,8,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top">
                                                <CheckBox
                                                    AutomationProperties.Name="事件开关"
                                                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                    Style="{StaticResource ToggleSwitchStyle}" />
                                                <TextBlock
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{StaticResource TextSecondaryBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="已关闭" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                    <Setter Property="Text" Value="已开启" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>

                                            <Button
                                                Grid.Column="5"
                                                VerticalAlignment="Top"
                                                Command="{Binding DeleteCommand}"
