                                                                    Style="{StaticResource IntervalPartInputStyle}"
                                                                    Text="{Binding IntervalDaysInput, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock
                                                                    Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                                    Text="天" />
                                                            </StackPanel>
                                                            <StackPanel
                                                                Margin="0,0,7,0"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding ShowIntervalHours, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBox
                                                                    Width="68"
                                                                    MaxLength="4"
                                                                    AutomationProperties.Name="提醒间隔小时"
                                                                    KeyDown="IntervalTextBox_OnKeyDown"
                                                                    Style="{StaticResource IntervalPartInputStyle}"
                                                                    Text="{Binding IntervalHoursInput, UpdateSourceTrigger=PropertyChanged}" />
                                                                <TextBlock
                                                                    Margin="4,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="13"
                                                                    Foreground="{StaticResource TextSecondaryBrush}"
