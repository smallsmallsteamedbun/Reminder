<Window
    x:Class="Reminder.App.UI.Views.StateRecoveryFailedDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="恢复失败"
    Width="450"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="StateRecoveryFailedDialog"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Margin="20"
        Padding="24"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderStrongBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Direction="270"
                Opacity="0.2"
                ShadowDepth="6"
                Color="{DynamicResource DialogShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource DangerSubtleBrush}"
                    CornerRadius="17">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DangerBrush}"
                        Text="!" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="恢复失败" />
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="无法从正式状态或备份中恢复数据。Reminder 将使用默认状态继续启动。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Margin="0,22,0,18"
                Background="{DynamicResource BorderBrush}" />

            <Button
                Grid.Row="2"
                MinWidth="84"
                HorizontalAlignment="Right"
                AutomationProperties.AutomationId="ConfirmRecoveryFailureButton"
                Click="ConfirmButton_OnClick"
                Content="确定"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </Border>
</Window>
