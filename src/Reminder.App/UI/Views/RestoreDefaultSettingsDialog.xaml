<Window
    x:Class="Reminder.App.UI.Views.RestoreDefaultSettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="恢复默认设置"
    Width="450"
    AllowsTransparency="True"
    AutomationProperties.AutomationId="RestoreDefaultSettingsDialog"
    Background="Transparent"
    FontFamily="{StaticResource AppFontFamily}"
    Foreground="{DynamicResource TextPrimaryBrush}"
    KeyDown="Window_OnKeyDown"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None">

    <Border
        Margin="20"
        Padding="24"
        Background="{DynamicResource SurfaceBrush}"
        BorderBrush="{DynamicResource BorderStrongBrush}"
        BorderThickness="1"
        CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect
                BlurRadius="24"
                Direction="270"
                Opacity="0.2"
                ShadowDepth="6"
                Color="{DynamicResource DialogShadowColor}" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="34"
                    Height="34"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="{DynamicResource DangerSubtleBrush}"
                    CornerRadius="17">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="18"
                        FontWeight="Bold"
                        Foreground="{DynamicResource DangerBrush}"
                        Text="!" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Text="是否恢复默认设置" />
                    <TextBlock
                        Margin="0,9,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        Text="所有设置将恢复默认值，开机自动启动和静默启动会关闭；事件、暂停状态与搜索历史不会被删除。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Height="1"
                Margin="0,22,0,18"
                Background="{DynamicResource BorderBrush}" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    MinWidth="84"
                    AutomationProperties.AutomationId="CancelRestoreDefaultsButton"
                    Click="CancelButton_OnClick"
                    Content="取消"
                    IsCancel="True"
                    Style="{StaticResource ReminderButtonStyle}" />
                <Button
                    MinWidth="84"
                    Margin="10,0,0,0"
                    AutomationProperties.AutomationId="ConfirmRestoreDefaultsButton"
                    Click="ConfirmButton_OnClick"
                    Content="确定"
                    IsDefault="True"
                    Style="{StaticResource DangerFilledButtonStyle}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
